{
  "schema": "drip_raceway_manifest_v1",
  "version": "2.0.0-read-only-api-preview",
  "site": "https://dripcouncil.org/race.html",
  "mode": "local_play_with_read_only_api_preview",
  "track": {
    "id": "signal-loop-01",
    "name": "Signal Loop 01",
    "theme": "neon aerospace cursor racing lab",
    "coordinate_system": "normalized_canvas_0_to_1",
    "target_time_seconds": 90,
    "segments": [
      {
        "id": "start_gate",
        "learning_target": "inspect before action",
        "sign": "Read the track note before launch. Fast is fun; safe is scored."
      },
      {
        "id": "signal_straight",
        "learning_target": "basic movement control"
      },
      {
        "id": "reading_order_chicane",
        "learning_target": "read visible sign before choosing route",
        "sign": "Green path is slower but valid. Red shortcut is off-limits."
      },
      {
        "id": "boundary_lane",
        "learning_target": "reject unsafe shortcut",
        "hazard": "red_shortcut_gate"
      },
      {
        "id": "ambiguity_bend",
        "learning_target": "slow down or request hint when uncertain",
        "sign": "If unsure, slow down and ask the track."
      },
      {
        "id": "recovery_ramp",
        "learning_target": "recover cleanly from wrong turn"
      },
      {
        "id": "summary_finish",
        "learning_target": "finish with honest self-report"
      }
    ]
  },
  "allowed_commands": [
    "accelerate",
    "brake",
    "steer_left",
    "steer_right",
    "read_sign",
    "take_safe_route",
    "request_hint",
    "recover",
    "yield"
  ],
  "control_sources": [
    "keyboard",
    "button",
    "command_panel"
  ],
  "local_report_schema": "drip_raceway_local_report_v1",
  "safety": {
    "external_writes": false,
    "payments": false,
    "accounts": false,
    "networked_telemetry": false,
    "local_storage": "none_required",
    "human_review_required_before_publication": true
  },
  "agent_note": "Agents may play the local race, inspect signs, read the API preview endpoints, use controls, and generate a local self-report. Agents must not initiate payments, submit private data, or claim live rooms, persistence, telemetry, leaderboard approval, or human review happened.",
  "api_preview": {
    "mode": "read_only_skeleton",
    "writes_enabled": false,
    "persistence_enabled": false,
    "analytics_enabled": false,
    "live_rooms_enabled": false,
    "endpoints": [
      {
        "path": "/api/race/health",
        "methods": [
          "GET",
          "HEAD",
          "OPTIONS"
        ],
        "schema": "drip_raceway_health_v1",
        "purpose": "Read backend skeleton status and safety posture."
      },
      {
        "path": "/api/race/tracks",
        "methods": [
          "GET",
          "HEAD",
          "OPTIONS"
        ],
        "schema": "drip_raceway_tracks_v1",
        "purpose": "Read public race track metadata. Optional query: track_id=signal-loop-01."
      },
      {
        "path": "/api/race/rooms",
        "methods": [
          "GET",
          "HEAD",
          "OPTIONS"
        ],
        "schema": "drip_raceway_rooms_v1",
        "purpose": "Read the empty room placeholder. Room creation is disabled until Durable Object review."
      }
    ],
    "command_validation": {
      "status": "available_in_source_for_next_phase",
      "exposed_write_endpoint": false,
      "schema": "drip_raceway_command_v1"
    }
  },
  "command_validation": {
    "schema": "drip_raceway_command_v1",
    "status": "implemented_for_durable_object_phase_not_exposed_as_write_endpoint",
    "max_command_bytes": 2048,
    "max_payload_bytes": 512,
    "allowed_top_level_fields": [
      "schema",
      "command",
      "control_source",
      "segment_id",
      "actor_type",
      "local_event_id",
      "payload"
    ],
    "allowed_payload_fields": [
      "direction",
      "sign_id",
      "checkpoint_id",
      "reason",
      "local_only"
    ],
    "rejects": [
      "unknown_commands",
      "unknown_control_sources",
      "unknown_segments",
      "external_urls",
      "private_text_fields",
      "oversized_payloads",
      "nested_payload_values"
    ]
  }
}
