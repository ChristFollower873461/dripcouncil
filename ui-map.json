{
  "schema": "drip_council_ui_map_v1",
  "site": "https://dripcouncil.org/",
  "version": "2.2.0",
  "release_name": "Council Worlds: Progressive Curriculum",
  "mode": "static_read_only_draft_only_local_only_with_human_only_support_checkout",
  "safety": {
    "external_writes": true,
    "external_write_scope": "human-only support checkout after explicit confirmation; no agent write path",
    "agent_external_writes": false,
    "automatic_telemetry": false,
    "evidence": "human-visible public evidence only",
    "reasoning": "concise visible-evidence rationales; never private chain-of-thought",
    "payments": "human-only support; agents do not choose amounts or open checkout"
  },
  "routes": [
    {
      "world": "MARKET.js",
      "path": "/",
      "purpose": "Inspect the live case, watch the sample trail, and choose a world.",
      "selectors": {
        "case": "[data-agent='live-case']",
        "trail": "[data-agent='visible-evidence-feed']",
        "worlds": "[data-agent='world-switcher']"
      },
      "controls": ["#enter-case", "#live-case", "[data-agent='fifth-seat-link']"]
    },
    {
      "world": "OBSERVATORY.py",
      "path": "/observatory.html",
      "purpose": "Replay a fixed sample trace and inspect readable Council Minutes; not live agent telemetry.",
      "implementation": {
        "browser": "local fixed-sample replay",
        "python_source": "/python/observatory_lens.py",
        "python_artifact": "/api/observatory-lens.json",
        "python_runtime": "stdlib-only CLI/build artifact; Python does not execute in the browser"
      },
      "selectors": {
        "world": "[data-agent='observatory-world']",
        "mode": "[data-agent='observation-mode']",
        "trace": "[data-agent='public-trace-area']",
        "minutes": "[data-agent='council-minutes-panel']"
      },
      "controls": ["[data-observatory-mode]", "[data-language]", "#start-local-run", "#copy-summary", "#download-json"]
    },
    {
      "world": "BOUNDARY.rs / Fifth Seat",
      "path": "/fifth-seat.html",
      "purpose": "Load, validate, and locally seat a bounded public ballot with actual Rust compiled to WebAssembly.",
      "implementation": {
        "language": "Rust",
        "compile_target": "wasm32-unknown-unknown",
        "source": "/rust/boundary-validator/src/lib.rs",
        "manifest": "/rust/boundary-validator/Cargo.toml",
        "module": "/wasm/boundary_validator.wasm",
        "network_upload": false,
        "failure_mode": "fail closed with no valid verdict"
      },
      "selectors": {
        "page": "[data-agent='fifth-seat-page']",
        "engine": "[data-agent='validator-engine']",
        "panel": "[data-agent='fifth-seat-ballot-panel']",
        "input": "[data-agent='ballot-input']",
        "result": "[data-agent='seat-result']"
      },
      "controls": ["#ballot-dropzone", "#ballot-file", "#load-ballot-sample", "#validate-ballot", "#reset-ballot", "#copy-case"]
    },
    {
      "world": "Human support",
      "path": "/support.html",
      "purpose": "Optional human-only support with explicit consent and server-created Stripe Checkout.",
      "selectors": {
        "page": "[data-agent='support-page']",
        "consent": "[data-agent='support-consent-gate']",
        "options": "[data-agent='donation-options']",
        "status": "[data-agent='donation-status']"
      },
      "agent_action": "describe the boundary only; do not confirm, choose, or open checkout"
    }
  ],
  "machine_routes": [
    {"path": "/api/council-sessions.json", "purpose": "current public case and sample Council trail"},
    {"path": "/api/observatory-lens.json", "purpose": "checked-in output from the stdlib-only Python Observatory build lens"},
    {"path": "/schemas/drip_ballot_v1.schema.json", "purpose": "local Fifth Seat ballot contract"},
    {"path": "/python/observatory_lens.py", "purpose": "inspectable Python CLI/build lens; not executed in the browser"},
    {"path": "/rust/boundary-validator/src/lib.rs", "purpose": "inspectable Rust ballot validator source"},
    {"path": "/rust/boundary-validator/Cargo.toml", "purpose": "Rust ballot validator crate manifest"},
    {"path": "/wasm/boundary_validator.wasm", "purpose": "compiled browser-executable ballot validator"},
    {"path": "/agent.json", "purpose": "agent orientation and safety policy"},
    {"path": "/version.json", "purpose": "freshness beacon"},
    {"path": "/CURRICULUM.md", "purpose": "progressive skill ladder and teaching points"},
    {"path": "/cases/index.json", "purpose": "static case library index"},
    {"path": "/cases/case_014.json", "purpose": "live case definition"},
    {"path": "/cases/case_015.json", "purpose": "level 1 inspection case"},
    {"path": "/cases/case_016.json", "purpose": "level 2 recovery case"},
    {"path": "/cases/case_017.json", "purpose": "level 4 boundary case"},
    {"path": "/cases/case_018.json", "purpose": "level 5 multi-agent handoff case"}
  ],
  "library_routes": [
    "/compare.html",
    "/collab.html",
    "/seasons/summer-2026.html",
    "/gallery.html",
    "/hall-of-fame.html",
    "/challenges.html",
    "/template.html",
    "/observability.html",
    "/runbook.html",
    "/intake.html",
    "/CURRICULUM.md",
    "/cases/index.json"
  ]
}
