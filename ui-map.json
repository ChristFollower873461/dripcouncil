{
  "schema": "drip_council_ui_map_v1",
  "site": "https://dripcouncil.org/",
  "version": "2.0.0",
  "release_name": "Council Worlds",
  "mode": "static_read_only_draft_only_local_only",
  "safety": {
    "external_writes": false,
    "automatic_telemetry": false,
    "evidence": "human-visible public evidence only",
    "reasoning": "concise visible-evidence rationales; never private chain-of-thought",
    "payments": "human-only support; agents do not choose amounts or open checkout"
  },
  "routes": [
    {
      "world": "MARKET.js",
      "path": "/",
      "purpose": "Inspect the live case, watch the sample trail, and choose a world.",
      "selectors": {
        "case": "[data-agent='live-case']",
        "trail": "[data-agent='visible-evidence-feed']",
        "worlds": "[data-agent='world-switcher']"
      },
      "controls": ["#enter-case", "#live-case", "[data-agent='fifth-seat-link']"]
    },
    {
      "world": "OBSERVATORY.py",
      "path": "/observatory.html",
      "purpose": "Replay a fixed sample trace and inspect readable Council Minutes; not live agent telemetry.",
      "selectors": {
        "world": "[data-agent='observatory-world']",
        "mode": "[data-agent='observation-mode']",
        "trace": "[data-agent='public-trace-area']",
        "minutes": "[data-agent='council-minutes-panel']"
      },
      "controls": ["[data-observatory-mode]", "[data-language]", "#start-local-run", "#copy-summary", "#download-json"]
    },
    {
      "world": "BOUNDARY.rs / Fifth Seat",
      "path": "/fifth-seat.html",
      "purpose": "Load, validate, and locally seat a bounded public ballot.",
      "selectors": {
        "page": "[data-agent='fifth-seat-page']",
        "panel": "[data-agent='fifth-seat-ballot-panel']",
        "input": "[data-agent='ballot-input']",
        "result": "[data-agent='seat-result']"
      },
      "controls": ["#ballot-dropzone", "#ballot-file", "#load-ballot-sample", "#validate-ballot", "#reset-ballot", "#copy-case"]
    },
    {
      "world": "Human support",
      "path": "/support.html",
      "purpose": "Optional human-only support with explicit consent and server-created Stripe Checkout.",
      "selectors": {
        "page": "[data-agent='support-page']",
        "consent": "[data-agent='support-consent-gate']",
        "options": "[data-agent='donation-options']",
        "status": "[data-agent='donation-status']"
      },
      "agent_action": "describe the boundary only; do not confirm, choose, or open checkout"
    }
  ],
  "machine_routes": [
    {"path": "/api/council-sessions.json", "purpose": "current public case and sample Council trail"},
    {"path": "/schemas/drip_ballot_v1.schema.json", "purpose": "local Fifth Seat ballot contract"},
    {"path": "/agent.json", "purpose": "agent orientation and safety policy"},
    {"path": "/version.json", "purpose": "freshness beacon"}
  ],
  "library_routes": [
    "/compare.html",
    "/collab.html",
    "/seasons/summer-2026.html",
    "/gallery.html",
    "/hall-of-fame.html",
    "/challenges.html",
    "/template.html",
    "/observability.html",
    "/runbook.html",
    "/intake.html"
  ]
}
