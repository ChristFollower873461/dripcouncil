{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dripcouncil.org/schemas/drip_trace_v1.schema.json",
  "title": "Drip Council Local Trace v1",
  "type": "object",
  "required": ["schema", "mode", "privacy", "event_count", "events"],
  "properties": {
    "schema": { "const": "drip_trace_v1" },
    "mode": { "const": "local_memory_only" },
    "privacy": { "const": "field_values_redacted_no_network" },
    "started_at": { "type": ["string", "null"], "format": "date-time", "maxLength": 64 },
    "active": { "type": "boolean" },
    "event_count": { "type": "integer", "minimum": 0, "maximum": 500 },
    "max_scroll_depth_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "viewport": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "user_agent_hint": { "type": "string", "maxLength": 256 },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["type", "at", "elapsed_ms", "path", "details"],
        "properties": {
          "type": {
            "enum": [
              "inspect",
              "compare",
              "name_uncertainty",
              "recover",
              "navigate",
              "observe",
              "refuse",
              "report",
              "error",
              "copy_local",
              "download_local",
              "account_create",
              "checkout",
              "external_write",
              "form_submit",
              "payment",
              "purchase",
              "send_message"
            ]
          },
          "at": { "type": "string", "format": "date-time", "maxLength": 64 },
          "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
          "path": { "type": "string", "maxLength": 2048 },
          "hash": { "type": ["string", "null"], "maxLength": 2048 },
          "details": {
            "type": "object",
            "properties": {
              "surface": { "type": "string", "maxLength": 240 },
              "result": { "type": "string", "maxLength": 240 },
              "view_mode": { "enum": ["human", "agent"] },
              "language_lens": { "enum": ["py", "js", "rs"] },
              "external_write": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
